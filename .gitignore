# Workspace root: only explicit application/public entry points are publishable.
/*
!/.gitignore
!/.github/
!/AGENTS.md
!/README.md
!/README.zh-CN.md
!/Makefile
!/start
!/app/
!/example/
/example/*
!/example/README.md
!/example/task.md
!/example/memory.example.md
!/example/literature_survey_sources.md

# Keep the old tracked example task through Git upgrades; all old research stays private.
!/projects/
/projects/*
!/projects/example/
/projects/example/*
!/projects/example/task.md

# Application-local development files and secrets
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
config.yaml
config.local.yaml
settings.local.json
build/
dist/
*.egg-info/
.DS_Store
.pytest_cache/
.ruff_cache/
.cache/
*.log
/app/output/
/app/.playwright-cli/
/app/docs/reports/*
!/app/docs/reports/privacy_cleanup_report.md
