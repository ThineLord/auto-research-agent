#!/usr/bin/env bash
set -euo pipefail
WORKSPACE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# Resolve a relative --workspace before cd. The server runs with cwd app/, so
# a caller-relative path would otherwise be resolved against app/.
CALLER_DIR="$(pwd)"
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --workspace)
      if [[ $# -lt 2 ]]; then
        args+=("$1")
        shift
        break
      fi
      value="$2"
      if [[ -n "$value" && "$value" != /* ]]; then
        value="${CALLER_DIR}/${value}"
      fi
      args+=("--workspace" "$value")
      shift 2
      ;;
    --workspace=*)
      value="${1#--workspace=}"
      if [[ -n "$value" && "$value" != /* ]]; then
        value="${CALLER_DIR}/${value}"
      fi
      args+=("--workspace=${value}")
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
cd "${WORKSPACE_DIR}/app"
if [[ ! -x .venv/bin/python && -z "${PYTHON:-}" ]]; then
  for candidate in python3.13 python3.12 python3.11 python3.10 python3; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' 2>/dev/null; then
      export PYTHON="$candidate"
      break
    fi
  done
fi
make install
exec .venv/bin/python -m ui.server "${args[@]}"
